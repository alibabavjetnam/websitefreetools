    },
    "marketing": {
      "name": "营销",
      "desc": "二维码、活动链接与品牌配色。"
    },
    "life": {
      "name": "效率与生活",
      "desc": "日常实用小工具。"
    },
    "health": {
      "name": "健康",
      "desc": "记录体重、营养、饮水、运动与周期。"
    },
    "edu": {
      "name": "教育与教学",
      "desc": "课程表、试卷、考勤、思维导图与酬劳。"
    },
    "time": {
      "name": "时间工具",
      "desc": "时钟、倒计时、时区、工作日与日记。"
    },
    "dev": {
      "name": "开发者工具",
      "desc": "源代码格式化、检查、加密与转换。"
    }
